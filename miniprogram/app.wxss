/* 雪夜祝福 · 全局样式（仅 class 选择器；组件/页面隔离下禁止标签/属性选择器） */

.page-root {
  --bg-deep: #0b1a12;
  --bg-mid: #143024;
  --pine: #2f6b45;
  --pine-lit: #3f8a58;
  --crimson: #b03a3a;
  --crimson-soft: #d45a5a;
  --gold: #e0b84a;
  --gold-soft: #f2d87a;
  --cream: #f4ecd8;
  --cream-dim: rgba(244, 236, 216, 0.78);
  --ink: #0a1510;

  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  background-color: #0b1a12;
  background-color: var(--bg-deep, #0b1a12);
  color: #f4ecd8;
  color: var(--cream, #f4ecd8);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.pixel-btn {
  display: block;
  width: 100%;
  margin: 0;
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  line-height: 1.2;
  text-align: center;
  color: #f4ecd8;
  color: var(--cream, #f4ecd8);
  background: #b03a3a;
  background: var(--crimson, #b03a3a);
  border: 4rpx solid #1a3d2a;
  border-radius: 0;
  box-shadow: 8rpx 8rpx 0 #1a3d2a;
}

.pixel-btn::after {
  border: none;
}

.pixel-btn-primary {
  background: #b03a3a;
  background: var(--crimson, #b03a3a);
  color: #f4ecd8;
  color: var(--cream, #f4ecd8);
}

.pixel-btn-ghost {
  background: transparent;
  color: #f2d87a;
  color: var(--gold-soft, #f2d87a);
  border-color: #3f8a58;
  border-color: var(--pine-lit, #3f8a58);
  box-shadow: 8rpx 8rpx 0 rgba(26, 61, 42, 0.55);
}

.pixel-btn-disabled {
  opacity: 0.45;
}

.privacy-note {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: rgba(244, 236, 216, 0.78);
  color: var(--cream-dim, rgba(244, 236, 216, 0.78));
  line-height: 1.5;
}

.ambient-bg {
  position: relative;
  width: 100%;
  min-height: 100%;
  overflow: hidden;
  background-color: #0b1a12;
  background-image: linear-gradient(180deg, #0a1a12 0%, #07140e 45%, #0b120e 100%);
}

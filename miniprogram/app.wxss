.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  background-color: #0b1a12;
  color: #f4ecd8;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.btn {
  display: block;
  width: 100%;
  margin: 0;
  padding: 10px 14px;
  font-size: 14px;
  line-height: 1.3;
  text-align: center;
  color: #f4ecd8;
  background-color: #b03a3a;
  border: 2px solid #1a3d2a;
  border-radius: 0;
  box-shadow: 3px 3px 0 #1a3d2a;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background-color: transparent;
  color: #f2d87a;
  border-color: #3f8a58;
}

.privacy {
  margin-top: 10px;
  font-size: 11px;
  line-height: 1.45;
  color: rgba(244, 236, 216, 0.72);
}

.pixel {
  image-rendering: pixelated;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 10px 12px;
  padding: 0 10px;
  background-color: rgba(20, 48, 36, 0.9);
  border: 2px solid #1a3d2a;
}

.search-input {
  flex: 1;
  height: 36px;
  font-size: 13px;
  color: #f4ecd8;
}

.section-title {
  display: block;
  margin: 14px 12px 8px;
  font-size: 15px;
  font-weight: 700;
  color: #f2d87a;
}

.empty {
  margin: 12px;
  padding: 16px;
  border: 1px dashed #2f6b45;
  font-size: 12px;
  color: rgba(244, 236, 216, 0.7);
  text-align: center;
}

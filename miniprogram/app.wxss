.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  background-color: #0b1a12;
  color: #f4ecd8;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.btn {
  display: block;
  width: 100%;
  margin: 0 0 12px 0;
  padding: 12px 18px;
  font-size: 15px;
  line-height: 1.3;
  text-align: center;
  color: #f4ecd8;
  background-color: #b03a3a;
  border: 2px solid #1a3d2a;
  border-radius: 0;
  box-shadow: 4px 4px 0 #1a3d2a;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background-color: transparent;
  color: #f2d87a;
  border-color: #3f8a58;
}

.btn-mini {
  display: inline-block;
  width: auto;
  margin: 0 4px 4px 0;
  padding: 6px 10px;
  font-size: 12px;
  box-shadow: 2px 2px 0 #1a3d2a;
}

.privacy {
  margin-top: 14px;
  font-size: 12px;
  line-height: 1.5;
  color: rgba(244, 236, 216, 0.78);
}

.pixel {
  image-rendering: pixelated;
}

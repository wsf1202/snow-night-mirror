.index-page {
  position: relative;
  padding: 48px 20px 40px;
  text-align: center;
  overflow: hidden;
  background-image: linear-gradient(180deg, #0a1a12 0%, #07140e 50%, #0b120e 100%);
}

.hero-art {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.art-tree {
  position: absolute;
  left: -4%;
  bottom: 2%;
  width: 140px;
  height: 170px;
  opacity: 0.9;
}

.art-gift {
  position: absolute;
  right: 6%;
  bottom: 8%;
  width: 70px;
  height: 70px;
}

.art-bell {
  position: absolute;
  right: 12%;
  top: 10%;
  width: 50px;
  height: 60px;
}

.hero {
  position: relative;
  z-index: 1;
  max-width: 360px;
  margin: 0 auto;
}

.tag {
  display: block;
  font-size: 11px;
  letter-spacing: 2px;
  color: #e0b84a;
  margin-bottom: 10px;
}

.brand {
  display: block;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.2;
  color: #f4ecd8;
  text-shadow: 2px 2px 0 #1a3d2a;
}

.latin {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: #f2d87a;
}

.lead {
  display: block;
  margin: 16px 0 24px;
  font-size: 14px;
  line-height: 1.55;
  color: rgba(244, 236, 216, 0.78);
}

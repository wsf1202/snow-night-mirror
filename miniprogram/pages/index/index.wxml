<view class="page index-page">
  <view class="hero-art">
    <image class="pixel art-tree" src="/assets/pixel/tree.png" mode="aspectFit"></image>
    <image class="pixel art-gift" src="/assets/pixel/gift.png" mode="aspectFit"></image>
    <image class="pixel art-bell" src="/assets/pixel/bell.png" mode="aspectFit"></image>
  </view>

  <view class="hero">
    <text class="tag">PIXEL SNOW NIGHT</text>
    <text class="brand">雪夜祝福</text>
    <text class="latin">Snow Night Mirror</text>
    <text class="lead">像素雪夜互动镜 · 对着镜头做手势，打开专属礼物祝福。</text>

    <button class="btn" bindtap="onStart">开启摄像头</button>
    <button class="btn btn-ghost" bindtap="onCustomize">定制礼物祝福</button>

    <text class="privacy">画面仅在手机本地处理，不会上传。</text>
  </view>
</view>

.stage-page {
  padding-bottom: 16px;
  background-color: #0b1a12;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
}

.topbar-brand {
  font-size: 15px;
  font-weight: 700;
  color: #f4ecd8;
  text-shadow: 1px 1px 0 #1a3d2a;
}

.topbar-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.viewport {
  position: relative;
  margin: 0 8px;
  height: 62vh;
  min-height: 320px;
  background-color: #05100b;
  border: 2px solid #1a3d2a;
  overflow: hidden;
}

.cam {
  width: 100%;
  height: 100%;
}

.cam-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(244, 236, 216, 0.78);
  font-size: 14px;
}

.coach {
  position: absolute;
  left: 8px;
  top: 8px;
  right: 8px;
  z-index: 5;
  max-width: 280px;
  padding: 10px;
  background-color: rgba(11, 26, 18, 0.92);
  border: 2px solid #1a3d2a;
}

.coach-progress {
  display: block;
  font-size: 11px;
  color: #e0b84a;
  margin-bottom: 6px;
}

.coach-guide {
  width: 100%;
  height: 100px;
  background-color: #0a1510;
  border: 1px solid #1a3d2a;
}

.coach-title {
  display: block;
  margin-top: 6px;
  font-size: 15px;
  font-weight: 700;
  color: #f4ecd8;
}

.coach-hint,
.coach-status {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.4;
  color: rgba(244, 236, 216, 0.78);
}

.coach-status {
  color: #f2d87a;
}

.coach-row {
  display: flex;
  margin-top: 8px;
}

.free-banner {
  position: absolute;
  left: 8px;
  top: 8px;
  z-index: 4;
  padding: 4px 8px;
  background-color: rgba(176, 58, 58, 0.85);
  border: 2px solid #1a3d2a;
  font-size: 12px;
  color: #f4ecd8;
}

.loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(5, 16, 11, 0.82);
  color: #f4ecd8;
  font-size: 14px;
}

.loading-sub {
  margin-top: 8px;
  font-size: 11px;
  color: rgba(244, 236, 216, 0.78);
  padding: 0 20px;
  text-align: center;
}

.toast {
  position: absolute;
  left: 50%;
  bottom: 12px;
  transform: translateX(-50%);
  z-index: 7;
  padding: 6px 12px;
  background-color: rgba(11, 26, 18, 0.88);
  border: 2px solid #e0b84a;
  font-size: 12px;
  color: #f4ecd8;
  white-space: nowrap;
}

.dock {
  margin-top: 10px;
  white-space: nowrap;
  padding: 0 8px;
  height: 40px;
}

.dock-item {
  display: inline-block;
  margin-right: 6px;
  padding: 8px 10px;
  border: 2px solid #1a3d2a;
  background-color: rgba(20, 48, 36, 0.9);
  font-size: 12px;
  color: #f4ecd8;
}

.dock-item.on {
  border-color: #e0b84a;
  color: #f2d87a;
}

.dock-hint {
  margin: 8px;
  padding: 8px;
  border: 2px solid #2f6b45;
  background-color: rgba(11, 26, 18, 0.7);
}

.dock-hint-title {
  display: block;
  font-size: 13px;
  color: #f2d87a;
  margin-bottom: 4px;
}

.dock-hint-body {
  font-size: 12px;
  color: rgba(244, 236, 216, 0.78);
  line-height: 1.4;
}

.dev {
  margin: 10px 8px 0;
  padding: 8px;
  border: 1px dashed #3f8a58;
}

.dev-label {
  display: block;
  font-size: 11px;
  color: rgba(244, 236, 216, 0.78);
  margin-bottom: 6px;
}

.stage-page {
  min-height: 100vh;
  background: #0b1a12;
  background: var(--bg-deep, #0b1a12);
  display: flex;
  flex-direction: column;
  padding-bottom: 24rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  gap: 12rpx;
}

.topbar-brand {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cream);
  text-shadow: 3rpx 3rpx 0 #1a3d2a;
  flex-shrink: 0;
}

.topbar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.icon-btn {
  margin: 0;
  padding: 0 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: var(--cream);
  background: rgba(20, 48, 36, 0.9);
  border: 3rpx solid #1a3d2a;
  border-radius: 0;
  box-shadow: 4rpx 4rpx 0 #1a3d2a;
}

.icon-btn::after {
  border: none;
}

.viewport {
  position: relative;
  margin: 0 16rpx;
  height: 62vh;
  min-height: 520rpx;
  background: #05100b;
  border: 4rpx solid #1a3d2a;
  overflow: hidden;
}

.cam,
.cam-placeholder {
  width: 100%;
  height: 100%;
  transform: scaleX(-1);
}

.cam-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cream-dim);
  font-size: 26rpx;
  transform: none;
}

.overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
  transform: scaleX(-1);
}

.viewport-frame {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.deco {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  image-rendering: pixelated;
}

.toast {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  z-index: 6;
  padding: 12rpx 24rpx;
  background: rgba(11, 26, 18, 0.88);
  border: 3rpx solid var(--gold);
  font-size: 24rpx;
  color: var(--cream);
}

.coach-panel {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 16rpx;
  z-index: 7;
  max-width: 420rpx;
  padding: 20rpx;
  background: rgba(11, 26, 18, 0.92);
  border: 4rpx solid #1a3d2a;
  box-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, 0.35);
}

.coach-progress {
  display: block;
  font-size: 22rpx;
  color: var(--gold);
  margin-bottom: 12rpx;
}

.coach-guide {
  width: 100%;
  height: 200rpx;
  background: #0a1510;
  border: 3rpx solid #1a3d2a;
  image-rendering: pixelated;
}

.coach-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cream);
}

.coach-hint,
.coach-status {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--cream-dim);
}

.coach-status {
  color: var(--gold-soft);
}

.coach-actions {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.coach-btn {
  flex: 1;
  font-size: 20rpx !important;
  padding: 8rpx 8rpx !important;
}

.coach-ok {
  margin-top: 12rpx;
  width: 100%;
  font-size: 26rpx !important;
}

.skip-all {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 7;
  margin: 0;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--cream-dim);
  background: rgba(11, 26, 18, 0.75);
  border: 2rpx solid var(--pine);
  border-radius: 0;
}

.skip-all::after {
  border: none;
}

.free-banner {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 5;
  padding: 8rpx 16rpx;
  background: rgba(176, 58, 58, 0.85);
  border: 3rpx solid #1a3d2a;
  font-size: 22rpx;
  color: var(--cream);
}

.loading-veil {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(5, 16, 11, 0.82);
  color: var(--cream);
  font-size: 26rpx;
}

.stub-note {
  font-size: 20rpx;
  color: var(--cream-dim);
  padding: 0 40rpx;
  text-align: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid var(--pine);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.effects-dock {
  margin-top: 16rpx;
  white-space: nowrap;
  padding: 0 16rpx;
  height: 72rpx;
}

.dock-item {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border: 3rpx solid #1a3d2a;
  background: rgba(20, 48, 36, 0.9);
  font-size: 22rpx;
  color: var(--cream);
}

.dock-item.on {
  border-color: var(--gold);
  color: var(--gold-soft);
}

.dock-hint {
  margin: 12rpx 16rpx 0;
  padding: 16rpx;
  border: 3rpx solid var(--pine);
  background: rgba(11, 26, 18, 0.7);
}

.dock-hint-title {
  display: block;
  font-size: 26rpx;
  color: var(--gold-soft);
  margin-bottom: 6rpx;
}

.dock-hint-body {
  font-size: 22rpx;
  color: var(--cream-dim);
  line-height: 1.4;
}

.dev-bar {
  margin: 20rpx 16rpx 0;
  padding: 16rpx;
  border: 2rpx dashed var(--pine-lit);
}

.dev-label {
  display: block;
  font-size: 20rpx;
  color: var(--cream-dim);
  margin-bottom: 10rpx;
}

.dev-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.customize-page {
  padding: 16px 18px 40px;
}

.nav-back {
  color: #f2d87a;
  font-size: 14px;
  margin-bottom: 12px;
}

.title {
  display: block;
  font-size: 26px;
  font-weight: 700;
  color: #f4ecd8;
  text-shadow: 2px 2px 0 #1a3d2a;
}

.sub {
  display: block;
  margin: 8px 0 20px;
  font-size: 13px;
  line-height: 1.5;
  color: rgba(244, 236, 216, 0.78);
}

.field {
  margin-bottom: 16px;
}

.label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6px;
}

.label {
  font-size: 13px;
  color: #f2d87a;
}

.meta {
  font-size: 12px;
  color: rgba(244, 236, 216, 0.78);
}

.input {
  width: 100%;
  padding: 10px 12px;
  background-color: rgba(20, 48, 36, 0.85);
  border: 2px solid #1a3d2a;
  color: #f4ecd8;
  font-size: 14px;
  border-radius: 0;
}

.area {
  min-height: 70px;
  width: 100%;
}

.box-picks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8px;
}

.box-pick {
  width: 48%;
  margin: 0 2% 8px 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 8px;
  border: 2px solid #1a3d2a;
  background-color: rgba(11, 26, 18, 0.7);
  font-size: 12px;
  color: #f4ecd8;
}

.box-pick.active {
  border-color: #e0b84a;
}

.swatch {
  width: 24px;
  height: 24px;
  margin-right: 8px;
  border: 2px solid #1a3d2a;
  border-bottom-width: 5px;
  flex-shrink: 0;
}

.share-box {
  margin-top: 18px;
  padding: 12px;
  border: 2px solid #2f6b45;
  background-color: rgba(20, 48, 36, 0.5);
}

.share-text {
  display: block;
  margin: 8px 0 12px;
  font-size: 12px;
  color: #f2d87a;
  word-break: break-all;
}

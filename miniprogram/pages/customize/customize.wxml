<view class="page customize-page">
  <view class="nav-back" bindtap="onBack">← 返回</view>
  <text class="title">定制礼物</text>
  <text class="sub">写下一句祝福，保存后进入体验。</text>

  <view class="field">
    <view class="label-row">
      <text class="label">祝福文案</text>
      <text class="meta">{{blessCount}}/{{maxBlessing}}</text>
    </view>
    <textarea class="input area" maxlength="{{maxBlessing}}" value="{{blessing}}" placeholder="圣诞快乐！" bindinput="onBlessingInput"></textarea>
  </view>

  <view class="field">
    <view class="label-row">
      <text class="label">署名（可选）</text>
      <text class="meta">{{sigCount}}/{{maxSignature}}</text>
    </view>
    <input class="input" maxlength="{{maxSignature}}" value="{{signature}}" placeholder="例如：小雪" bindinput="onSignatureInput" />
  </view>

  <view class="field">
    <text class="label">礼物盒外观</text>
    <view class="box-picks">
      <view
        wx:for="{{boxStyles}}"
        wx:key="id"
        class="box-pick {{selectedBox === item.id ? 'active' : ''}}"
        data-box="{{item.id}}"
        bindtap="onPickBox"
      >
        <view class="swatch" style="background-color:{{item.box}};border-bottom-color:{{item.ribbon}};"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <button class="btn" bindtap="onSave">保存并体验</button>
  <button class="btn btn-ghost" bindtap="onSharePreview">生成分享参数</button>

  <view wx:if="{{shareQuery}}" class="share-box">
    <text class="label">分享 path</text>
    <text class="share-text" selectable>pages/stage/stage?{{shareQuery}}</text>
    <button class="btn btn-ghost" bindtap="onCopy">复制</button>
    <text class="privacy">祝福写在启动参数里；摄像头画面仍只在对方手机本地处理。</text>
  </view>
</view>
